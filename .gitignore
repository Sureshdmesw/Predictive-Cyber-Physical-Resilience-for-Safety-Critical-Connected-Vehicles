# ============================================================
# Raw / downloaded datasets
# Keep these outside Git; manifests/documentation describe them.
# ============================================================
data/raw/
*.zip
*.7z
*.rar

# ============================================================
# Very large generated numerical arrays
# ============================================================
data/processed/**/*.npy

# ============================================================
# Large generated parquet datasets
# ============================================================
data/processed/**/*.parquet

# ============================================================
# Large redundant JSONL telemetry artifacts
# CSV/evidence summaries remain tracked.
# ============================================================
data/processed/can_hil/phase5_9/*.jsonl
data/processed/can_hil/phase5_10/*.jsonl

# ============================================================
# Models
# Intentionally NOT ignored.
# All current model checkpoints are < 5 MB and will be tracked.
# ============================================================

# ============================================================
# Private document
# ============================================================
Cortex_XDR_Occupant.docx

# ============================================================
# Runtime / temporary files
# ============================================================
*.log
*.tmp
*.bak

# ============================================================
# Large HCRL real cyber telemetry datasets
# Keep locally; repository tracks scripts, schemas, manifests,
# documentation, and compact evidence summaries.
# ============================================================
data/processed/real_cyber_telemetry/hcrl_car_hacking/*.csv

# Large generated HCRL baseline model
models/real_cyber_telemetry_baseline/rf_baseline_model.joblib
